# CVB Opportunity Trackers - Environment Configuration

# === REQUIRED ===

# Obsidian Daily Notes Directory
OBSIDIAN_DAILY_DIR=/Users/coolvibecoding/Documents/Obsidian/Daily/

# Telegram Bot Configuration (for alerts)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=telegram:-1003713071598

# === OPTIONAL ===

# Notion Integration (for database entries)
NOTION_API_KEY=secret_your_notion_key
NOTION_DATABASE_ID=your_database_id

# GitHub API Token (increases rate limits)
GITHUB_TOKEN=ghp_your_token_here

# === AGENT ZERO DEPLOYMENT ===
# These are used when running in Docker on Agent Zero
AGENT_ZERO_PORT=55025
